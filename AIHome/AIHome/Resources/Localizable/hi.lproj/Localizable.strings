"inspiration.item.interior-01.title" = "अटारी बायोफिलिक धुंधली भव्यता";
"inspiration.item.interior-01.subtitle" = "एक परिष्कृत, ऑर्गैनिक स्थान में प्रकृति और गहन परिष्कार का सहज मेल।";
"inspiration.item.interior-02.title" = "रेस्तरां विंटेज क्रिमसन विलासिता";
"inspiration.item.interior-02.subtitle" = "गहरे लाल रंगों और मखमली दौर की भव्यता में लिपटा एक उच्च-स्तरीय भोजन अनुभव।";
"inspiration.item.interior-03.title" = "बाथरूम स्कैंडिनेवियन एक्वा चमक";
"inspiration.item.interior-03.subtitle" = "एक ताज़गी भरी, चमकदार जल-प्रेरित आभा से युक्त स्वच्छ नॉर्डिक मिनिमलिज़्म।";
"inspiration.item.interior-04.title" = "बाथरूम ट्रॉपिकल एमराल्ड आकर्षण";
"inspiration.item.interior-04.subtitle" = "गहरे वन हरे रंगों और विदेशी वानस्पतिक ठाठ का हरा-भरा, जीवंत आश्रय।";
"inspiration.item.interior-05.title" = "बाथरूम कोस्टल समुद्री हवा";
"inspiration.item.interior-05.subtitle" = "हल्की बनावट और महासागर-प्रेरित रंगों से परिभाषित एक हवादार, नमकीन आश्रय।";
"inspiration.item.interior-06.title" = "बाथरूम बायोफिलिक वन छत्र";
"inspiration.item.interior-06.subtitle" = "जीवंत हरियाली और प्राकृतिक, छनती रोशनी में पूर्ण विसर्जन।";
"inspiration.item.interior-07.title" = "बेडरूम मैक्सिमलिस्ट फीका बेर";
"inspiration.item.interior-07.subtitle" = "एक परिष्कृत, पुराने बैंगनी में समृद्ध बनावटों की साहसिक, विविध परतें।";
"inspiration.item.interior-08.title" = "स्टडी रूम ऑर्गैनिक मॉडर्न छत्र";
"inspiration.item.interior-08.subtitle" = "एक हाई-टेक पुस्तकालय जहाँ डिजिटल उपकरण हरे-भरे, ऑर्गैनिक लकड़ी से मिलते हैं।";
"inspiration.item.interior-09.title" = "बेडरूम साइबरपंक नियॉन सॉर्बे";
"inspiration.item.interior-09.subtitle" = "जीवंत, मीठी सिंथेटिक चमक से मिलती हाई-टेक तीखी सौंदर्यशैली।";
"inspiration.item.interior-10.title" = "बेडरूम बोहो पीच मैदान";
"inspiration.item.interior-10.subtitle" = "कोमल, सूर्यास्त-प्रेरित गर्माहट के साथ स्तरित स्वतंत्र-भावना वाली बनावट।";
"inspiration.item.interior-11.title" = "स्टडी रूम जापांडी आसमानी तट";
"inspiration.item.interior-11.subtitle" = "गहरे, समुद्री नीले रंगों से उभरा शांत, कार्यात्मक मिनिमलिज़्म।";
"inspiration.item.interior-12.title" = "ऑफिस विलासिता मिट्टी जैसे रंग";
"inspiration.item.interior-12.subtitle" = "प्रीमियम सामग्रियों और समृद्ध, ठोस रंगों से परिभाषित एक पेशेवर सुइट।";
"inspiration.item.interior-13.title" = "डाइनिंग रूम विलासिता सुनहरा नीलम";
"inspiration.item.interior-13.subtitle" = "समृद्ध धात्विक सोने और गहरे, राजसी रत्न-नीले का एक भव्य मेल।";
"inspiration.item.interior-14.title" = "डाइनिंग रूम जापांडी शांत रेत";
"inspiration.item.interior-14.subtitle" = "गर्म, तटस्थ रेगिस्तानी रंगों में लिपटा सामंजस्यपूर्ण ज़ेन मिनिमलिज़्म।";
"inspiration.item.interior-15.title" = "डाइनिंग रूम विंटेज देहाती आकर्षण";
"inspiration.item.interior-15.subtitle" = "पुरानी लकड़ी और पुरानी यादों वाले विवरणों का जश्न मनाता एक आरामदायक स्थान।";
"inspiration.item.interior-16.title" = "लिविंग रूम मैक्सिमलिस्ट नियॉन सॉर्बे";
"inspiration.item.interior-16.subtitle" = "चमकीले, फलदार विद्युत रंगों से प्रकाशित पैटर्न और बनावट का विस्फोट।";
"inspiration.item.interior-17.title" = "लिविंग रूम स्कैंडिनेवियन बर्फीले नीले";
"inspiration.item.interior-17.subtitle" = "ताज़ा, ठंडे सर्दियों के रंगों से शीतल स्वच्छ नॉर्डिक रेखाएँ।";
"inspiration.item.interior-18.title" = "होम ऑफिस कोस्टल शरद आभा";
"inspiration.item.interior-18.subtitle" = "मौसम के अंत की धूप और आरामदायक, गिरे-पत्तों वाले रंगों से गर्म एक हवादार कार्यस्थल।";
"inspiration.item.interior-19.title" = "होम ऑफिस क्रिसमस शांत रेत";
"inspiration.item.interior-19.subtitle" = "तटस्थ रंगों और सूक्ष्म अवकाश गर्माहट के साथ उत्सवी, संयमित भव्यता।";
"inspiration.item.interior-20.title" = "लिविंग रूम मिडसेंचुरी रेट्रो जंग";
"inspiration.item.interior-20.subtitle" = "गहरे, मिट्टी जैसे नारंगी और लकड़ी में जमी 1950 के दशक की प्रतिष्ठित आकृतियाँ।";
"inspiration.item.interior-21.title" = "किचन रेनबो कोमल क्षितिज";
"inspiration.item.interior-21.subtitle" = "एक स्वच्छ, आधुनिक लेआउट में बहता एक चंचल फिर भी कोमल रंग वर्णक्रम।";
"inspiration.item.interior-22.title" = "किचन ऑर्गैनिक मॉडर्न मिट्टी जैसे रंग";
"inspiration.item.interior-22.subtitle" = "कच्ची लकड़ी और मिट्टी-प्रेरित पैलेट को उजागर करता एक शेफ-स्तरीय स्थान।";
"inspiration.item.interior-23.title" = "किचन ट्रांज़िशनल स्लेट रंग";
"inspiration.item.interior-23.subtitle" = "परिष्कृत, ठंडे धूसर रंगों से परिभाषित पुराने और नए का कालातीत मेल।";
"inspiration.item.interior-24.title" = "किचन विलासिता सुनहरा तट";
"inspiration.item.interior-24.subtitle" = "उच्च-स्तरीय फिनिश एक गर्म, समुद्रतट-प्रेरित धात्विक आभा से मिलते हैं।";
"inspiration.item.interior-25.title" = "लिविंग रूम देहाती कैंडी आसमान";
"inspiration.item.interior-25.subtitle" = "स्वप्निल, सूर्यास्त पेस्टल रंगों में रंगा पुराना ग्रामीण आकर्षण।";
"inspiration.item.interior-26.title" = "लिविंग रूम प्यारा बच्चों वाला फ्रॉस्टेड पेस्टल";
"inspiration.item.interior-26.subtitle" = "मीठे, मैट-फिनिश हल्के रंगों में एक कोमल, चंचल पारिवारिक स्थान।";
"inspiration.item.exterior-27.title" = "बालकनी मॉडर्न फार्म हाउस मिट्टी जैसे रंग";
"inspiration.item.exterior-27.subtitle" = "प्राकृतिक लकड़ी और ठोस, ऑर्गैनिक रंगों वाला एक शांत बाहरी आश्रय।";
"inspiration.item.exterior-28.title" = "अपार्टमेंट सेंचुरी वनक्षेत्र आश्रय";
"inspiration.item.exterior-28.subtitle" = "हरे-भरे, प्राचीन जंगल में छिपे कालातीत वास्तुशिल्प विवरण।";
"inspiration.item.exterior-29.title" = "घर मॉडर्न तटस्थ रेत";
"inspiration.item.exterior-29.subtitle" = "गर्म, रेगिस्तान-प्रेरित रंगों में फिनिश तीखे, समकालीन किनारे।";
"inspiration.item.exterior-30.title" = "रैंच अलफ्रेस्को किचन पीच मैदान";
"inspiration.item.exterior-30.subtitle" = "गर्म, सूर्यास्त-प्रेरित रंगों में नहाया एक हवादार, विस्तृत लेआउट।";
